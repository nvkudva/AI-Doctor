{
  // Static-asset Worker. There is no server code: the Worker exists to serve
  // dist/ and to answer every unmatched path with the SPA shell, so
  // /patient/labs/… and /doctor/case/… survive a reload and a shared link.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aidoctor",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
