# Copy to .env and fill in to enable real Google sign-in.
# Without these, the login page runs in demo mode.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Voice: Google Cloud key for real STT + TTS in consults (enable the
# Speech-to-Text and Text-to-Speech APIs, restrict the key by HTTP referrer).
# Without it the app uses free built-in browser speech. Free tiers: STT ~60
# min/mo, TTS Standard 4M / Neural2 1M chars/mo. Runtime override available
# via localStorage `vd_google_key`.
#VITE_GOOGLE_CLOUD_KEY=your-google-cloud-key
# Consult brain: Gemini API key from AI Studio (aistudio.google.com).
# Without it consults run on the built-in demo engine. Runtime override via
# localStorage `vd_gemini_key`. Free tier covers dev/test consult volume.
#VITE_GEMINI_API_KEY=your-gemini-key
