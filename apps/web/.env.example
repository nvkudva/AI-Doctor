# Copy to .env.local and fill in. With these two unset the app runs in demo
# mode: seeds + localStorage, no network, exactly as it behaved before the
# backend existed.
#
# Only these two ever belong in this app. The anon key is public by design and
# is enforced by RLS; a service-role key or any model/provider key must never
# appear here — those live on the Edge Functions (supabase/functions/.env).

# Local stack (`bun run db:start` prints these as API URL / anon key):
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# The seeded demo accounts' shared password (supabase/README.md). Set it and the
# login page's "Fake patient" / "Fake doctor" buttons sign in as real seeded
# users under real RLS; leave it unset and they stay local-only.
#VITE_DEMO_PASSWORD=1234

# The tenant to act as when the hostname carries no subdomain (localhost).
VITE_TENANT_SLUG=citycare
